# ====================================================================
# Contoh konfigurasi environment backend SmartSkin.
# Copy file ini jadi `.env` lalu sesuaikan nilainya:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# JANGAN commit `.env` asli (berisi secret). File ini cuma template.
# ====================================================================

# --- Server ---
APP_PORT=3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=hardware
DB_LOGGING=true
DB_SYNCHRONIZATION=false

# --- Auth (JWT) ---
# WAJIB diisi string acak panjang & unik. Jangan pakai contoh ini di produksi.
# Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=ganti-dengan-string-acak-panjang
# Masa berlaku token (format zeit/ms: 12h, 8h, 7d, dst). Default 12h.
JWT_EXPIRES_IN=12h

# --- Akun admin (dipakai saat `npm run seed:admin`) ---
# Username boleh dibiarkan default. Password WAJIB diisi sebelum deploy;
# kalau dikosongkan, seeder pakai default dev + kasih warning.
ADMIN_STASRG_USERNAME=stas-rg
ADMIN_STASRG_PASSWORD=
ADMIN_PINDAD_USERNAME=pindad
ADMIN_PINDAD_PASSWORD=

# --- Lainnya ---
# Set ke "production" di server deploy supaya SeederModule (dev) tidak ikut jalan.
# NODE_ENV=development
